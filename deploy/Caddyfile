# Caddy: the only service exposed to the internet in production.
# - Gets and renews a free HTTPS certificate (Let's Encrypt) for $DOMAIN.
# - Serves the UI and the API from the same address (API under /api), so
#   the login cookie is first-party and no cross-site requests are needed.
# - Adds security headers.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Uploads are capped at 20 MB by the backend; reject anything larger here.
	request_body {
		max_size 25MB
	}

	handle_path /api/* {
		reverse_proxy backend:8000 {
			# Stream audit progress (Server-Sent Events) without buffering.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
