# Ollama API URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Folder for everything the app stores (Default: ./data). Data from older
# versions in the project root is moved here automatically on first start.
DATA_DIR=./data
# Override individual locations if needed (defaults are inside DATA_DIR):
# AUDIT_DB_PATH=./data/audit_history.db
# CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Default LLM model name (Default: llama3.2). Can also be changed at runtime
# from the Settings page.
MODEL_NAME=llama3.2

# Backend server port (Default: 8000)
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the backend (CORS).
# Default covers the Next.js dev server only — no wildcard, since the
# backend has no authentication.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Performance tuning (all optional) ---
# Max files audited per repository/upload run (default 25; each file costs
# roughly a minute on a CPU-only machine).
MAX_FILES_PER_AUDIT=25
# Simultaneous LLM calls. Keep 1 on CPU; raise only with a GPU / OLLAMA_NUM_PARALLEL>1.
LLM_CONCURRENCY=1
# Let the LLM write the Reviewer's executive summary (slower, one extra call per file).
REVIEWER_USE_LLM=false

# --- Analysis (all optional) ---
# Run bandit / ruff (and semgrep, if installed) before the AI agents.
STATIC_ANALYSIS_ENABLED=true
# Custom semgrep rule file (default: rules/semgrep.yml, JS/TS only).
# SEMGREP_RULES=./rules/semgrep.yml
# Most findings each AI agent may report per code chunk (more = slower).
MAX_FINDINGS_PER_CHUNK=2
# ChromaDB memory of past audits (only used by REVIEWER_USE_LLM summaries).
# Requires: pip install -r requirements-memory.txt
MEMORY_ENABLED=false
