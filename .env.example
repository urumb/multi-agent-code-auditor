# Ollama API URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Path to local model weights (Default: ./local_models)
OLLAMA_MODELS=./local_models

# Path to ChromaDB persistence directory (Default: ./chroma_db)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Path to the SQLite audit history database (Default: ./audit_history.db)
AUDIT_DB_PATH=./audit_history.db

# Default LLM model name (Default: llama3.2). Can also be changed at runtime
# from the Settings page.
MODEL_NAME=llama3.2

# Backend server port (Default: 8000)
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the backend (CORS).
# Default covers the Next.js dev server only — no wildcard, since the
# backend has no authentication.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Performance tuning (all optional) ---
# Max files audited per repository/upload run (default 25; each file costs
# roughly a minute on a CPU-only machine).
MAX_FILES_PER_AUDIT=25
# Simultaneous LLM calls. Keep 1 on CPU; raise only with a GPU / OLLAMA_NUM_PARALLEL>1.
LLM_CONCURRENCY=1
# Let the LLM write the Reviewer's executive summary (slower, one extra call per file).
REVIEWER_USE_LLM=false
